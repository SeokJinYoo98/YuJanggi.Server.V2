<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="local-protocol" value="D:\Git\YuJanggi.Protocol.V2\artifacts" />
		<add key="local-core" value="D:\Git\YuJanggi.Core.V2\artifacts" />
	</packageSources>

	<packageSourceMapping>
		<packageSource key="local-protocol">
			<package pattern="YuJanggi.Protocol.V2" />
		</packageSource>
		
		<packageSource key="local-core">
			<package pattern="YuJanggi.Core.V2" />
		</packageSource>

		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>